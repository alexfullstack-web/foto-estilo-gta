# ─────────────────────────────────────────────────────────────
#  Copie este arquivo para "server/.env" e preencha os valores.
#  NUNCA envie o arquivo .env para o GitHub.
# ─────────────────────────────────────────────────────────────

PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# ── Provedor de IA: reapi | openai ───────────────────────────
AI_PROVIDER=reapi

# Tempo máximo de espera pela IA (ms)
GENERATION_TIMEOUT_MS=240000

# ── reAPI (https://reapi.ai) ─────────────────────────────────
# Crie a chave em https://reapi.ai/settings/apikeys
REAPI_API_KEY=

# Modelos de edição com foto:
#   gpt-image-2           (mais barato)
#   gpt-image-2-official  (canal estável, aceita REAPI_QUALITY)
#   nano-banana-2-lite    (Google, só 1K)
REAPI_MODEL=gpt-image-2
REAPI_RESOLUTION=1k
REAPI_QUALITY=medium

# Onde hospedar a foto para o reAPI baixar (ele não aceita a foto direto):
#   imgbb → envia ao ImgBB, que apaga sozinho em IMGBB_EXPIRATION_SECONDS (RECOMENDADO, sem túnel)
#   self  → este backend serve a foto (precisa de PUBLIC_BASE_URL acessível pela internet)
INPUT_HOST=imgbb
# Chave grátis em https://api.imgbb.com (faça login e clique em "Get API key")
IMGBB_API_KEY=
IMGBB_EXPIRATION_SECONDS=600

# Só para INPUT_HOST=self — URL PÚBLICA deste backend, acessível pela internet (https).
# O reAPI não aceita a foto enviada direto: ele baixa de um link.
# Em desenvolvimento use um túnel, ex.:
#   cloudflared tunnel --url http://localhost:3001
# e cole aqui a URL https://....trycloudflare.com que aparecer.
# Em produção, use o domínio do seu backend.
PUBLIC_BASE_URL=

# ── OpenAI (alternativa: AI_PROVIDER=openai) ─────────────────
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# ── Limites de uso ───────────────────────────────────────────
MAX_UPLOAD_MB=10
DAILY_LIMIT_PER_IP=10
GLOBAL_DAILY_LIMIT=200

# ── Armazenamento dos resultados ─────────────────────────────
# disk  → pasta server/storage (seu PC ou VPS)
# imgbb → ImgBB com expiração (OBRIGATÓRIO na Vercel; usa a mesma IMGBB_API_KEY)
# Se não definir: "imgbb" na Vercel e "disk" no resto.
RESULT_STORE=disk
RESULT_RETENTION_HOURS=24

# true se rodar atrás de proxy reverso (Nginx, Render, Railway, túnel)
TRUST_PROXY=false
