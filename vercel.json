{
  "services": {
    "web": {
      "root": "client/",
      "framework": "vite"
    },
    "api": {
      "root": "server/",
      "framework": "express",
      "entrypoint": "src/index.js"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
